# vim: set filetype=zsh :
#
# Snapshot a shell integration with `zgenom eval`, from the generator recorded for it in
# $_zsh_integrations.
#
#   zsh-eval-integration <name>
#
# Does nothing when the tool is not installed. This is for building the save: a snapshot that
# already exists is replaced by zsh-refresh-integration when its tool turns out to be newer.

local generator=$_zsh_integrations[$1]
if [[ -z $generator ]]; then
  print -u2 "zsh-eval-integration: no generator for '$1'"
  return 1
fi

(( $+commands[${generator%% *}] )) || return 0

zgenom eval --name $1 < <(eval $generator)
