# vim: set filetype=zsh :
#
# zgenom extension: keep the output of a tool as a plugin, and record what produced it.
#
#   zgenom eval-tool [--completion] <name> <generator> [args ...]
#
# Like `zgenom eval --name <name>`, with the generator passed as arguments rather than on stdin so
# that it can be kept and rerun. Quote it if it contains shell syntax:
#
#   zgenom eval-tool direnv direnv hook zsh
#   zgenom eval-tool fzf 'fzf --zsh; echo compdef _gnu_generic fzf'
#
# --completion writes the output as _<name> into a directory that is added to $fpath rather than
# sourced, which is what compinit expects of a completion function: it is then autoloaded on the
# first completion of <name>, so a command nobody completes costs nothing at all. Use it for a
# generator whose output is only a completion function. Anything that has to be in place before the
# first prompt, a prompt or a hook, has to be sourced and so cannot use it.
#
# The generator is written beside the output for `zgenom refresh-tools` to replay when the tool
# changes, which is the whole reason this exists: a snapshot is otherwise taken once and never
# revisited, and goes stale as soon as the tool is upgraded.
#
# Nothing happens for a tool that is not installed, so no snapshot of a missing command's error
# output can be kept, and generating is skipped when the output is already current: rebuilding the
# save does not have to rerun every tool.

local completion
zparseopts -D -E -completion=completion || return

local name=$1
shift
local generator="$*"

if [[ -z $name || -z $generator ]]; then
  __zgenom_err '`eval-tool` requires a name and a generator:'
  __zgenom_err '`zgenom eval-tool [--completion] <name> <generator> [args ...]`'
  return 1
fi

# Separate locations, so a tool can have both: cm's integration and its completion are generated by
# different commands and only one of them can be sourced.
local repo target
if [[ -n $completion ]]; then
  repo=zgenom_comp/$name
  target=_$name
else
  repo=zgenom_eval/$name
  target=init.zsh
fi

local dir=$(zgenom api clone_dir $repo)
local output=$dir/$target
# Hidden so it stays out of the way of the directory's other job as an $fpath entry, and left
# without a shebang so `zgenom compile` skips it.
local record=$dir/.generator

if (( $+commands[${generator%% *}] )); then
  # What the record holds: the file to write on the first line, the generator on the rest, which is
  # all `zgenom refresh-tools` needs to redo this later.
  local content="$target"$'\n'"$generator"

  # Compared as well as the tool, so editing a generator in plugins.zsh takes effect on the next
  # save even though the tool itself has not changed.
  local recorded
  [[ -s $record ]] && read -rd '' recorded < $record

  if zsh-tool-changed-since $output ${generator%% *} || [[ ${recorded%$'\n'} != $content ]]; then
    zsh-generate-file $output $generator || return
    print -r -- $content >! $record
  fi
fi

# An uninstalled tool keeps whatever was generated while it was installed, but there is nothing to
# put on $fpath or source until something has been.
[[ -s $output ]] || return 0

if [[ -n $completion ]]; then
  zgenom load --completion $repo
else
  zgenom load $repo
fi
