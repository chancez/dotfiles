# vim: set filetype=zsh :
#
# zgenom extension: regenerate every `zgenom eval-tool` output whose tool has changed since it was
# produced.
#
#   zgenom refresh-tools
#
# Run before `zgenom saved`, which sources the snapshots: they are rewritten in place, and the saved
# init.zsh loads them from a path that does not change, so a new copy takes effect without
# rebuilding the save. Output from plain `zgenom eval` has no record and is left alone.
#
# This runs at every startup, and is built out of builtins for that reason: a tool runs only once
# its output is out of date. Doing the same lazily is only possible for a completion, and only
# because compinit defers loading it; a prompt or a hook has to be in place before the first prompt,
# which is to say before anything can ask for it.

emulate -L zsh

local record dir generator output

for record in $ZGEN_DIR/zgenom_*/*/*/.generator(N); do
  dir=${record:h}

  # First line is the file the generator writes, the rest is the generator. -d '' so one spanning
  # several lines survives being read back; it reports failure at end of file having assigned what
  # it read, so the value is what to test rather than the status.
  read -rd '' generator < $record
  output=$dir/${generator%%$'\n'*}
  generator=${${generator#*$'\n'}%$'\n'}

  [[ -n $generator && -s $output ]] || continue

  zsh-tool-changed-since $output ${generator%% *} || continue

  # Deliberately not loaded here: `zgenom saved` does that a moment later for a sourced snapshot,
  # and compinit already knows where to find a completion.
  zsh-generate-file $output $generator
done
