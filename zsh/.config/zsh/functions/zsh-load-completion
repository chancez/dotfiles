# vim: set filetype=zsh :
#
# Load a tool's completion function, generated by the tool itself and cached until it changes.
#
# Asking a tool for its completion script is slow enough that doing it at every startup is what
# the `zgenom eval` snapshots in plugins.zsh exist to avoid, but a snapshot is taken once and
# never revisited, so completions stayed stale until the next `zgenom reset`. Caching the output
# outside the zgenom save instead means it can be replaced whenever the tool it came from turns
# out to be newer, without rebuilding anything else.
#
# Called from a stub in $ZDOTDIR/completions named _<cmd> whose first line is `#compdef <cmd>`:
#
#   zsh-load-completion <name> <generator> [args ...]
#
# <name> is the completion function to load, without the leading underscore. <generator> is a
# command writing a zsh completion script to stdout. compinit autoloads the stub the first time
# <cmd> is completed, which is also the only time the generator can run, so a tool that is never
# completed never costs anything.
#
# plugins.zsh sources the stubs with $_zsh_completion_warm set while it builds the zgenom save.
# That fills the cache in the same place the snapshots used to be taken, so the first completion
# in a new shell is not the one that pays for generating it.

# Deliberately no `emulate -L zsh`: this runs inside the completion system, and the completion
# function being loaded relies on the options _main_complete set up for it (extended_glob among
# them, without which `_arguments` matches nothing). Only aliases are turned off, so an alias
# cannot change what the generated script means.
setopt local_options no_aliases

local name=$1
shift

local cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions
local cache=$cache_dir/_$name

# A mise shim is a symlink to the mise binary, so a shimmed tool's own path only ever tracks mise
# itself. The lockfile is what changes when mise installs a different version of the tool.
local -a triggers=($commands[$1])
if [[ $commands[$1] == */mise/shims/* ]]; then
  triggers+=(${XDG_CONFIG_HOME:-$HOME/.config}/mise/mise.lock)
fi

# Both tests are builtins, so completing a command whose cache is current forks nothing.
local trigger stale=0
[[ -s $cache ]] || stale=1
for trigger in $triggers; do
  if [[ $trigger -nt $cache ]]; then
    stale=1
    break
  fi
done

# An uninstalled tool still completes from whatever was cached while it was installed.
if (( stale )) && (( $+commands[$1] )); then
  [[ -d $cache_dir ]] || mkdir -p $cache_dir

  # Generate into a temporary file, so a generator that fails or is interrupted cannot leave a
  # truncated completion behind to be cached until the tool changes again.
  local tmp=$cache.$$
  if "$@" >! $tmp && [[ -s $tmp ]]; then
    mv -f $tmp $cache
  else
    rm -f $tmp
  fi
fi

# Warming wants the cache written and nothing else.
if (( ${_zsh_completion_warm:-0} )); then
  [[ -s $cache ]]
  return
fi

[[ -s $cache ]] || return 1

# Sourcing replaces the stub with the real completion function for the rest of the session. Stop
# if it did not, rather than calling the stub again and recursing.
local stub=$functions[_$name]
source $cache
[[ $functions[_$name] != $stub ]] || return 1

_$name
