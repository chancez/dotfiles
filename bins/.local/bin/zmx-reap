#!/usr/bin/env python3
"""Report, and optionally kill, zmx sessions that no terminal is showing.

Dry run by default: it prints what it would do and exits. Pass --kill to act.

A session is only a candidate when nothing is attached to it AND its shell has no
child processes. Both matter: a detached session can still be holding a build, an
ssh connection, or an editor with unsaved work, and killing it takes the work with
it. `clients=0` alone means "nobody is looking at it right now", which is not the
same as abandoned.

Sessions are searched across every zmx socket directory found, not just the one
the current environment resolves to. A process that started without TMPDIR set
lands in /tmp/zmx-501 instead of the usual per-user temp dir, so `zmx ls` in one
environment cannot see sessions created in the other, and orphans accumulate
there unseen.
"""

import argparse
import glob
import json
import os
import re
import subprocess
import sys

KITTEN = '/Applications/kitty.app/Contents/MacOS/kitten'
LSOF = '/usr/sbin/lsof'
DEFAULT_PATTERN = r'^kitty\.\d+$'


def run(cmd, **kw):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=15, **kw).stdout
    except Exception:
        return ''


def socket_dirs(only=None):
    """Socket dirs to search.

    An explicit dir restricts the search rather than adding to it, so a caller
    aiming at one directory cannot accidentally reap sessions elsewhere. Otherwise
    every plausible dir is searched, since a process started without TMPDIR set
    lands in /tmp/zmx-501 and its orphans are invisible to a `zmx ls` run from a
    normal shell.
    """
    explicit = only or os.environ.get('ZMX_DIR')
    if explicit:
        if not os.path.isdir(explicit):
            sys.exit(f'not a directory: {explicit}')
        return [os.path.realpath(explicit)]

    dirs = set()
    for pat in ('/tmp/zmx-*', os.path.join(os.environ.get('TMPDIR', '/tmp'), 'zmx-*')):
        for p in glob.glob(pat):
            if os.path.isdir(p):
                dirs.add(os.path.realpath(p))
    return sorted(dirs)


def sessions_in(sock_dir):
    env = dict(os.environ, ZMX_DIR=sock_dir)
    out = run(['zmx', 'ls'], env=env)
    found = {}
    for line in out.splitlines():
        fields = dict(re.findall(r'(\w+)=(\S*)', line))
        name = fields.get('name')
        if name:
            fields['_dir'] = sock_dir
            found[name] = fields
    return found


def windowed_sessions():
    """Session names currently displayed by a kitty window, across all instances.

    Read from the socket each client holds rather than its launch arguments: after
    a session switch the arguments still name the session the window started with,
    so trusting them can mark a live session as an orphan.
    """
    peer_to_session = {}
    for line in run([LSOF, '-U']).splitlines():
        m = re.search(r'/zmx-\d+/(\S+)$', line)
        dev = re.search(r'(0x[0-9a-f]+)', line)
        if m and dev:
            peer_to_session[dev.group(1)] = m.group(1)

    shown = set()
    for sock in glob.glob('/tmp/kitty-*'):
        if not re.fullmatch(r'/tmp/kitty-\d+', sock):
            continue
        out = run([KITTEN, '@', '--to', 'unix:' + sock, 'ls'])
        if not out:
            continue
        try:
            data = json.loads(out)
        except json.JSONDecodeError:
            continue
        for osw in data:
            for tab in osw['tabs']:
                for w in tab['windows']:
                    pid = w.get('pid')
                    if not pid:
                        continue
                    peers = re.findall(r'->(0x[0-9a-f]+)',
                                       run([LSOF, '-p', str(pid), '-a', '-U']))
                    for p in peers:
                        if p in peer_to_session:
                            shown.add(peer_to_session[p])
    return shown


def children_of(pid):
    out = run(['pgrep', '-P', str(pid)]).split()
    procs = []
    for c in out:
        cmd = run(['ps', '-o', 'command=', '-p', c]).strip()
        if cmd:
            procs.append((c, cmd))
    return procs


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--kill', action='store_true',
                    help='actually kill the reapable sessions (default is a dry run)')
    ap.add_argument('--pattern', default=DEFAULT_PATTERN,
                    help=f'only consider sessions matching this regex (default {DEFAULT_PATTERN})')
    ap.add_argument('--all-names', action='store_true',
                    help='consider every session, not just ones matching --pattern')
    ap.add_argument('--dir', help='search only this socket dir (also honours ZMX_DIR)')
    args = ap.parse_args()

    pattern = None if args.all_names else re.compile(args.pattern)

    dirs = socket_dirs(args.dir)
    if not dirs:
        sys.exit('no zmx socket directories found')

    all_sessions = {}
    for d in dirs:
        for name, fields in sessions_in(d).items():
            all_sessions[(d, name)] = fields

    if not all_sessions:
        print('no zmx sessions found')
        return

    shown = windowed_sessions()

    reapable, kept = [], []
    for (d, name), f in sorted(all_sessions.items()):
        if pattern and not pattern.match(name):
            kept.append((name, d, 'name does not match pattern'))
            continue
        if name in shown:
            kept.append((name, d, 'has a kitty window'))
            continue
        if f.get('clients', '0') != '0':
            kept.append((name, d, f"clients={f.get('clients')}"))
            continue
        pid = f.get('pid')
        kids = children_of(pid) if pid else []
        if kids:
            kept.append((name, d, 'running: ' + kids[0][1][:60]))
            continue
        prog = f.get('PROG')
        if prog and prog != '-':
            kept.append((name, d, f'PROG={prog}'))
            continue
        reapable.append((name, d, f))

    for name, d, why in kept:
        print(f'keep  {name:<12} {why}   [{d}]')

    if not reapable:
        print('\nnothing to reap')
        return

    print()
    for name, d, f in reapable:
        print(f'reap  {name:<12} pid={f.get("pid")} start_dir={f.get("start_dir", "")}   [{d}]')

    if not args.kill:
        print(f'\n{len(reapable)} session(s) would be killed; re-run with --kill')
        return

    print()
    for name, d, _ in reapable:
        env = dict(os.environ, ZMX_DIR=d)
        subprocess.run(['zmx', 'kill', name, '--force'], env=env,
                       capture_output=True, text=True, timeout=15)
        print(f'killed {name}   [{d}]')


if __name__ == '__main__':
    main()
