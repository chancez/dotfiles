#!/bin/sh
# Attach to a zmx session, creating it if needed.
#
# kitty's save_as_session records a window's launch argv, not the process
# actually running in it. Going through this wrapper keeps the session name in
# the argv (as $1) so restoring the session reattaches instead of creating a new
# one, and keeps the saved path stable rather than baking in the versioned mise
# install path that resolving `zmx` directly would produce.
# A ZMX_SESSION in the environment makes `attach` retarget that session's
# existing client instead of attaching this terminal, so an inherited value
# would hijack whichever window is already showing it.
unset ZMX_SESSION

session=$1

# The title is emitted by the shell from precmd, and reattaching runs no new
# shell and delivers no signal, so a restored window keeps kitty's fallback
# title (the process name) until something is typed in it. SIGWINCH makes zsh
# re-run the title hooks without touching the pty input, so nothing is echoed
# into the terminal or the scrollback. zmx already sends one when a client
# attaches at a different size than the last one; this covers the case where the
# size is unchanged.
#
# Backgrounded because the attach below replaces this process, and delayed
# because the client has to be connected before the signal is worth sending.
{
  sleep 1
  # Fields are tab separated and matched whole: a name is a prefix of other
  # names (kitty.1 of kitty.11) and '.' would match anything as a pattern.
  pid=$(zmx ls 2>/dev/null | awk -F'\t' -v want="name=$session" '
    {
      for (i = 1; i <= NF; i++) { sub(/^ +/, "", $i); if ($i == want) match_found = 1 }
      if (match_found) {
        for (i = 1; i <= NF; i++) if ($i ~ /^pid=/) { sub(/^pid=/, "", $i); print $i; exit }
      }
    }')
  [ -n "$pid" ] && kill -WINCH "$pid" 2>/dev/null
} &

exec zmx attach "$session"
