#!/usr/bin/env python3
# kspaces' keeper for windows that run in cm sessions, as launch_wrapper.py runs every window (see "Closing
# and suspending sessions" in kspaces' docs/kitty.md for the protocol).
#
#   kspaces-keeper-cm keep     reads {"session", "mode", "windows"}, shelves the cm sessions the windows
#                              attach to, prints {"kept": [NAME...]}
#   kspaces-keeper-cm forget   reads {"session", "kept"}, has cm forget the ones that have not come back
#
# A window's cm session is its cm_session user variable, which launch_wrapper.py sets, else the one its
# program or a program in its foreground attaches to with cm-attach or cm attach. Only running sessions are
# shelved: one already ended has nothing to stop. Closing keeps them for a week, as cm keeps any ended
# session; suspending keeps them until they are restored or forgotten. Forgetting leaves alone a session
# that is running again, attached to by a window.
#
# Standalone rather than importing cm_common.py, which imports kitty and so only loads inside kitty.

import json
import os
import subprocess
import sys

SESSION_VAR = 'cm_session'
CLOSED_RETENTION = '168h'
# cm-attach's options that take a value, which is not the session's name. As cm_common.py's.
CM_ATTACH_VALUED = frozenset({'--dir', '--ssh', '--ssh-cwd'})


def session_in_argv(argv):
    """The cm session argv attaches to, None when it runs no cm-attach or cm attach. As cm_common.py's."""
    if not argv:
        return None
    prog = os.path.basename(argv[0])
    if prog == 'cm-attach':
        args = iter(argv[1:])
        for arg in args:
            if arg in CM_ATTACH_VALUED:
                next(args, None)
            elif not arg.startswith('-'):
                return arg
        return None
    if prog == 'cm' and len(argv) >= 3 and argv[1] in ('attach', 'a'):
        for arg in argv[2:]:
            if arg == '--':
                break
            if not arg.startswith('-'):
                return arg
    return None


def session_of(window):
    if name := (window.get('user_vars') or {}).get(SESSION_VAR):
        return name
    for argv in [window.get('cmdline')] + (window.get('foreground') or []):
        if name := session_in_argv(argv):
            return name
    return None


def cm(*args):
    r = subprocess.run(['cm', *args], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit('cm %s: %s' % (args[0], (r.stderr or r.stdout).strip()))
    return r.stdout


def states():
    """Each cm session's state, by each of its names."""
    by = {}
    for s in json.loads(cm('list', '--json')):
        for name in [s['name']] + (s.get('names') or []):
            by[name] = s.get('state', '')
    return by


def keep(req):
    names = []
    for w in req.get('windows') or []:
        name = session_of(w)
        if name and name not in names:
            names.append(name)
    if names:
        state = states()
        names = [n for n in names if state.get(n) == 'running']
    if names:
        args = ['shelve']
        if req.get('mode') == 'close':
            args += ['--expire-after', CLOSED_RETENTION]
        cm(*args, *names)
    json.dump({'kept': names}, sys.stdout)


def forget(req):
    kept = req.get('kept') or []
    if not kept:
        return
    state = states()
    ended = [n for n in kept if n in state and state[n] != 'running']
    if ended:
        cm('forget', *ended)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ('keep', 'forget'):
        sys.exit('usage: kspaces-keeper-cm keep|forget, with a JSON request on stdin')
    req = json.load(sys.stdin)
    (keep if sys.argv[1] == 'keep' else forget)(req)


if __name__ == '__main__':
    main()
