#!/bin/sh
# Attach to a cm session, creating it if needed.
#
# Exists so a window's command line names `cm-attach` rather than wherever cm resolved to: kitty's
# save_as_session recorded a window's argv with argv[0] resolved to an absolute path, and this looks cm
# up again on every restore.
# Usage: cm-attach [--space SPACE] [--worktree W] [--dir DIR] [--shell | --in-shell] NAME [command...]
#        cm-attach [--space SPACE] [--worktree W] --ssh HOST [--ssh-cwd PATH] [--ssh-command] NAME [command...]
#
# --dir starts the cm attach client, and so a new session, in DIR: launch_wrapper.py passes the window's
# directory, which can differ from kitty's, see window_dir there. For a session on another host, NAME
# qualified as HOST:NAME, DIR is a directory there, so it goes to cm attach --dir instead: cm sends a remote
# no directory of the client's, as one here would mean nothing there. kitty runs a shell on macOS through
# /usr/bin/login, which starts in the home directory, so without it the client stayed there, and kitty took
# that for the window's directory while a program ran in it.
#
# --shell is for a window that runs only a shell: the command kitty puts after the prefix, on macOS its
# run-shell kitten and the shell, is left out, and cm starts the shell itself. Run in the session, that
# command would be the session's program rather than a shell, and cm would bring that command line back on a
# restore instead of what was running in the shell.
#
# --ssh runs `kitten ssh HOST` in the session, in PATH on the far side: launch_wrapper.py passes it when
# the window a new one is opened from has ssh'd elsewhere, so the new session reconnects instead of
# running locally, as kitty does for a window running `kitten ssh`. Without --ssh-command what follows
# the name, the local shell kitty puts there, is ignored and the far side starts its login shell; with
# it, the command runs on the far side, with a terminal (ssh -t). ssh joins its arguments with spaces
# for the far side's shell, so the command goes as one argument, each word quoted, or `sh -c 'a b'`
# would arrive as `sh -c a b`. PATH travels as KITTY_LOGIN_CWD, which the ssh kitten's bootstrap reads
# on the far side and ssh.conf copies across, set for this one process so it cannot leak into a later
# `kitten ssh` typed by hand.
#
# The `--` cm needs is added here rather than by the caller, deliberately. Passing it through kitty would
# put a `--` in the middle of a `launch` command line, where kitty's own option parser sees it first, and
# whether it survives is a question this avoids having to answer.
#
# --if-running=attach, because the command runs only when the session is new or revived: restoring a saved
# kitty session reruns this with the same command while the cm session is still running, and without it
# cm refuses that attach and the window shows only an error.
#
# --in-shell types the command into the session's shell rather than running it in place of the shell, which
# is how launch_wrapper.py keeps a window after its command for kitty's launch --hold.
#
# --space and --worktree say where a session this creates belongs, from the kitty session the window is in:
# its cm space, and a worktree tag kspaces uses to pick a kitty session when it opens the session again. Both
# are ignored when the session exists. The space goes as CM_SPACE, which cm attach reads as --space, rather
# than as the flag, so a cm too old to know spaces ignores it instead of refusing every window; cm keeps it
# out of the session's environment. launch_wrapper.py passes only names cm accepts, since one it refused
# would end the window.
#
# KITTY_SI_RUN_COMMAND_AT_STARTUP is how kitty restores a window saved while its shell ran a program: kitty's
# shell integration runs it at the shell's first prompt. kitty learns that program from the shell's own
# reports, which cm passes on, so a saved cm window got it too, and a revived session's shell ran it on top
# of what cm brings back: vim twice, the second typed into the first. cm restores what ran, so it is unset.
unset KITTY_SI_RUN_COMMAND_AT_STARTUP

# ship_integration has `kitten ssh` install kitty's shell integration on HOST, where kitty.zsh loads it for a
# session there: such a session's shell is started by HOST's cm server, which neither kitty nor `kitten ssh`
# reaches, and the client's KITTY_INSTALLATION_DIR names the Mac's app bundle. `kitten ssh HOST true` copies
# the integration into ~/.local/share/kitty-ssh-kitten on HOST, as every `kitten ssh` does, and runs nothing
# else. Once per host and kitty version, recorded here, so a split normally costs reading one file; only
# inside a kitty window, whose terminal the kitten sends the files through. A failure is left for the next
# session to retry: the session still opens, without the integration.
ship_integration() {
  [ -n "${KITTY_WINDOW_ID:-}" ] || return 0
  kitten=$(command -v kitten 2>/dev/null)
  if [ -z "$kitten" ] && [ -n "${KITTY_INSTALLATION_DIR:-}" ]; then
    kitten="$KITTY_INSTALLATION_DIR/../../MacOS/kitten"
  fi
  [ -n "$kitten" ] && [ -x "$kitten" ] || return 0
  version=$("$kitten" --version 2>/dev/null | head -n 1)
  stamp="$HOME/.local/state/kitty-cm/integration/$1"
  [ -n "$version" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$version" ] && return 0
  # The host as cm reaches it: ssh://[user@]host[:port][/path] in `cm config`, the name itself for none.
  address=$(cm config 2>/dev/null | sed -n "s|^remote\.hosts\.$1 ssh://\([^/ ]*\).*|\1|p")
  dest=${address:-$1}
  port=
  case $dest in
    *:*) port=${dest##*:}; dest=${dest%:*} ;;
  esac
  if "$kitten" ssh ${port:+-p "$port"} "$dest" true; then
    mkdir -p "${stamp%/*}" && printf '%s\n' "$version" > "$stamp"
  fi
}
shell=
in_shell=
dir=
ssh_host=
ssh_cwd=
ssh_command=
tag=
while :; do
  case $1 in
    --space) export CM_SPACE="$2"; shift 2 ;;
    --worktree) tag="--tag worktree=$2"; shift 2 ;;
    --shell) shell=1; shift ;;
    --in-shell) in_shell=--in-shell; shift ;;
    --dir) dir=$2; shift 2 ;;
    --ssh) ssh_host=$2; shift 2 ;;
    --ssh-cwd) ssh_cwd=$2; shift 2 ;;
    --ssh-command) ssh_command=1; shift ;;
    *) break ;;
  esac
done
name=$1
shift
if [ -n "$ssh_host" ]; then
  tty=
  remote=
  if [ -n "$ssh_command" ]; then
    tty=-t
    for word; do
      remote="$remote '$(printf '%s' "$word" | sed "s/'/'\\\\''/g")'"
    done
  fi
  set --
  [ -n "$remote" ] && set -- "$remote"
  # --on-restore=command, for this session alone: a revive after a reboot or a wake runs its command again,
  # `kitten ssh HOST`, so the window reconnects rather than coming back as a local shell. Allowlisting
  # kitten in safe_commands instead would match every kitten.
  if [ -n "$ssh_cwd" ]; then
    exec cm attach --if-running=attach --on-restore=command $tag "$name" -- env "KITTY_LOGIN_CWD=$ssh_cwd" kitten ssh $tty "$ssh_host" "$@"
  fi
  exec cm attach --if-running=attach --on-restore=command $tag "$name" -- kitten ssh $tty "$ssh_host" "$@"
fi
if [ -n "$shell" ]; then
  set --
fi
attach_dir=
case $name in
  *:*) attach_dir=$dir; ship_integration "${name%%:*}" ;;
  *) [ -n "$dir" ] && cd "$dir" 2>/dev/null ;;
esac
if [ "$#" -gt 0 ]; then
  exec cm attach --if-running=attach $in_shell $tag ${attach_dir:+--dir "$attach_dir"} "$name" -- "$@"
fi
exec cm attach $tag ${attach_dir:+--dir "$attach_dir"} "$name"
