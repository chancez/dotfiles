# Spaces shown in the kspaces sidebar, one repository per line, in display order.
space ~/projects/work/hubble-timescape
space ~/projects/gr
space ~/projects/work/isovalent-operator
space ~/projects/work/docs-hypershield
space ~/projects/work/docs-reference
space ~/projects/kitty
space ~/projects/cm
space ~/projects/kspaces
space ~/.dotfiles

# Open a worktree's first tab through cm, like cmd+t does. kspaces appends --cwd and
# --add-to-session.
new_tab kitten cm_launch.py --type=tab

# Saved sessions (save_sessions.py), restored when a worktree with no windows is opened.
sessions ~/.local/share/kitty/sessions

# New worktrees made from the sidebar go in .worktrees/NAME on pr/chancez/NAME.
worktree_dir .worktrees
branch_prefix pr/chancez/
