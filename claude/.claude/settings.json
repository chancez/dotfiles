{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(agora:*)",
      "Bash(gr *)",
      "Bash(kspaces new:*)",
      "Bash(kspaces run:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agora inject"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CM_SESSION\" ] && [ -n \"$CLAUDE_PID\" ] || exit 0; set -- $(ps -o pgid=,tpgid= -p \"$CLAUDE_PID\"); [ \"$1\" = \"$2\" ] || exit 0; id=$(jq -r '.session_id // empty'); [ -n \"$id\" ] && cm restore-with -- claude --resume \"$id\" >/dev/null 2>&1; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agora leave --force",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agora inject"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agora inject --limit 3"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "agora guard",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/notify-notification.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/notify-end.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "agora doorbell --wait 30m",
            "timeout": 1800,
            "asyncRewake": true
          }
        ]
      }
    ],
    "StopFailure": [],
    "SubagentStart": [],
    "SubagentStop": [],
    "TeammateIdle": [],
    "PostToolUseFailure": [],
    "PermissionRequest": [],
    "PostCompact": []
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "cm@cm": true,
    "mattpocock-skills@claude-plugins-official": true,
    "modern-go-guidelines@goland-claude-marketplace": true
  },
  "extraKnownMarketplaces": {
    "cm": {
      "source": {
        "source": "github",
        "repo": "chancez/cm"
      }
    },
    "goland-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "JetBrains/go-modern-guidelines"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "autoMode": {
    "allow": [
      "$defaults",
      "gr reviews: You are permitted to run all gr commands, comment, review, submit, etc. You can and should set GR_AUTHOR."
    ]
  },
  "deny": [
    "Read(./.env)",
    "Read(./.env.*)",
    "Read(./secrets/**)"
  ]
}
